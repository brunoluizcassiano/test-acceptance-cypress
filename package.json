{
  "name": "test-acceptance-cypress",
  "version": "1.0.59",
  "description": "Framework de automação base utilizando cypress",
  "main": "index.js",
  "exports": {
    "./schemaWrapper": "./cypress/commom/schema/SchemaWrapper.js",
    "./schemaValidator": "./cypress/commom/schema/SchemaValidator.js",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:brunoluizcassiano/test-acceptance-cypress.git"
  },
  "keywords": [
    "bdd",
    "tests"
  ],
  "author": "Bruno Luiz Cassiano do Santos",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/brunoluizcassiano/test-acceptance-cypress/issues"
  },
  "homepage": "https://github.com/brunoluizcassiano/test-acceptance-cypress#readme",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "../../cypress/integration/**/*.js"
    ],
    "filterSpecs": true,
    "cucumberJson": {
      "generate": true,
      "outputFolder": "../../cypress/report/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".json"
    }
  },
  "dependencies": {
    "cypress": "12.17.4",
    "@badeball/cypress-cucumber-preprocessor": "^20.1.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.2",
    "ajv": "^8.16.0",
    "cypress-parallel": "^0.14.0",
    "dotenv": "^16.4.5",
    "js-beautify": "^1.15.1",
    "pdfmake": "^0.2.13",
    "properties-reader": "^2.3.0",
    "request": "^2.88.2",
    "typescript": "^5.5.4"
  }
}
